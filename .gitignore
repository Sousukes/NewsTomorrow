# ---- 根级忽略（子目录另有各自的 .gitignore）----

# OCR 委派审查的临时产物
.tmp/

# Agent 记忆与工作目录（非项目内容，不参与代码审查）
.workbuddy/
.workbuddy-ai/

# Python 运行时缓存
.pytest_cache/
__pycache__/
*.py[cod]

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本地跑服务/契约检查时的临时日志（排查用，不该进仓库）
mock-run.log
contract-run.log
*-run.log

# 单测/校验脚本的临时输出（pytest / vitest / verify / build 重定向产物）
.tmp*.log

# 覆盖率产物（F2）：`.coverage` 是 SQLite 数据文件，`htmlcov/` 是 HTML 报告
# —— 两者都是本地生成物，`.coveragerc` 才是要进版本库的那份配置
.coverage
.coverage.*
htmlcov/
coverage.xml
