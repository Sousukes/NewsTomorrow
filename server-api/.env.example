# 复制为 .env 并按需修改（或直接用环境变量）

# development（默认，放开 Swagger / CORS *） | production（收紧 + 强制校验密钥）
ENVIRONMENT=development

# SQLite：DATABASE_URL=sqlite:///./toutiao.db
# PostgreSQL（推荐生产使用，需先建库）：
DATABASE_URL=postgresql+psycopg://toutiao:你的密码@localhost:5432/toutiao

# ---- 连接池（PostgreSQL 生效）----
# 峰值并发连接数 = DB_POOL_SIZE + DB_MAX_OVERFLOW
# 经验值：连接数 ≈ CPU 核数 * 2 + 有效磁盘数；Web 服务按 (核数*2+5) 起步
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 等待可用连接的最长秒数，超时抛TimeoutError
DB_POOL_TIMEOUT=30
# 连接最大存活秒数，应小于 PG 的 idle_timeout（防静默断开）
DB_POOL_RECYCLE=1800
# 取连接前探活，避免把死连接交给业务
DB_POOL_PRE_PING=true
# 建连超时秒数
DB_CONNECT_TIMEOUT=10
# 便于在 pg_stat_activity 中识别本应用
DB_APP_NAME=toutiao-api

# 【生产必填】未设置或仍为默认值时，production 模式启动会直接失败
# 留空即可（视为未设置，会回退到开发默认值）；但生产留空会触发 fail-fast
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# 允许的跨域来源，逗号分隔。development 默认 *；production 默认同源（不跨域）
CORS_ORIGINS=

# ---- 管理员（可触发敏感操作）----
# 可调用 POST /api/news/refresh 的手机号白名单（逗号分隔）；留空表示生产禁用该接口
ADMIN_PHONES=

# ---- 接口限流 ----
# 按客户端 IP 固定窗口计数（登录类单独更严阈值；不按路径分桶）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
# 设置后限流改用 Redis 共享计数（多实例 / 多 worker 正确）；留空用进程内实现
# 例：REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
# 受信反向代理网段（逗号分隔，IP 或 CIDR）。仅当直连对端命中该网段时，
# 才采信 X-Forwarded-For 首段作为客户端 IP；留空表示不信任任何代理头
# （防止任意客户端伪造 XFF 绕过限流）。例：127.0.0.1,::1,10.0.0.0/8
TRUSTED_PROXIES=

# 访问日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- RSS 新闻抓取（全部为免费公开源，无需 API Key）----
# 定时抓取开关与周期（分钟）
FEED_CRON_ENABLED=true
FEED_CRON_INTERVAL_MINUTES=30
# 单源最多取几条
FEED_LIMIT_PER_SOURCE=30
# HTTP 超时（总/ 连接），秒
FEED_TIMEOUT=15
FEED_CONNECT_TIMEOUT=8
# 过期数据清理：保留天数 / 最小保留条数
FEED_KEEP_DAYS=30
FEED_KEEP_MIN=200

# ---- 示例数据播种 ----
# 是否播种「演示账号 + 示例资讯/评论/消息」。生产默认 false（避免弱口令默认账号与演示内容）；
# 单元测试建议置 false 以保证断言确定性
SEED_SAMPLE_DATA=true

# 种子演示账号（仅当 SEED_SAMPLE_DATA=true 时生效）
DEMO_PHONE=13800138000
DEMO_PASSWORD=123456
# ---- 抓取链路治理（P1-16）----
FEED_MAX_CONCURRENCY=4
FEED_HOST_GAP_SECONDS=1.5
FEED_MIN_INTERVAL_MINUTES=10
FEED_ROBOTS_TTL_HOURS=24
FEED_ALERT_ENABLED=true
FEED_ALERT_STALE_HOURS=24
FEED_ALERT_MIN_INTERVAL_HOURS=6
FEED_ALERT_AGGREGATE_MIN=3
FEED_ALERT_AGGREGATE_LIST=5

# ---- 失败分级与熔断（P1-18）----
# 「可重试」失败（超时 / 5xx / 429 / 连接重置）的重试次数与退避基数（秒，指数退避）
FEED_RETRY_TRANSIENT=2
FEED_RETRY_BACKOFF=0.6
# 连续失败达此次数即熔断：冷却期内整轮跳过该源（0 = 不熔断）
FEED_CIRCUIT_THRESHOLD=5
FEED_CIRCUIT_COOLDOWN_MINUTES=30
# 连续「永久性」失败达此次数后自动禁用该源。
# 默认 0 = **从不自动禁用**——静默关掉一个源、且没人记得重新打开，比一直重试更糟；
# 开启后每次触发都会写审计（source.auto_disable）
FEED_AUTO_DISABLE_PERMANENT=0
