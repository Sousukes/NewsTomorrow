# 复制为 .env 并按需修改（或直接用环境变量）

# development（默认，放开 Swagger / CORS *） | production（收紧 + 强制校验密钥）
ENVIRONMENT=development

# SQLite：DATABASE_URL=sqlite:///./toutiao.db
# PostgreSQL（推荐生产使用，需先建库）：
DATABASE_URL=postgresql+psycopg://toutiao:你的密码@localhost:5432/toutiao

# ---- 连接池（PostgreSQL 生效）----
# 峰值并发连接数 = DB_POOL_SIZE + DB_MAX_OVERFLOW
# 经验值：连接数 ≈ CPU 核数 * 2 + 有效磁盘数；Web 服务按 (核数*2+5) 起步
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 等待可用连接的最长秒数，超时抛TimeoutError
DB_POOL_TIMEOUT=30
# 连接最大存活秒数，应小于 PG 的 idle_timeout（防静默断开）
DB_POOL_RECYCLE=1800
# 取连接前探活，避免把死连接交给业务
DB_POOL_PRE_PING=true
# 建连超时秒数
DB_CONNECT_TIMEOUT=10
# 便于在 pg_stat_activity 中识别本应用
DB_APP_NAME=toutiao-api

# 【生产必填】未设置或仍为默认值时，production 模式启动会直接失败
# 留空即可（视为未设置，会回退到开发默认值）；但生产留空会触发 fail-fast
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# 允许的跨域来源，逗号分隔。development 默认 *；production 默认同源（不跨域）
CORS_ORIGINS=

# ---- 管理员（可触发敏感操作）----
# 可调用 POST /api/news/refresh 的手机号白名单（逗号分隔）；留空表示生产禁用该接口
ADMIN_PHONES=

# ---- 接口限流 ----
# 按客户端 IP 固定窗口计数（登录类单独更严阈值；不按路径分桶）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
# 登录失败锁定（C2，账号维度）：同一账号连续失败达上限即临时锁定整个窗口，
# 与 IP 限流互补（防「换 IP 打同一个账号」）。成功登录即清零。
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=900
# 设置后限流改用 Redis 共享计数（多实例 / 多 worker 正确）；留空用进程内实现
# 例：REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
# 受信反向代理网段（逗号分隔，IP 或 CIDR）。仅当直连对端命中该网段时，
# 才采信 X-Forwarded-For 首段作为客户端 IP；留空表示不信任任何代理头
# （防止任意客户端伪造 XFF 绕过限流）。例：127.0.0.1,::1,10.0.0.0/8
TRUSTED_PROXIES=

# 访问日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- RSS 新闻抓取（全部为免费公开源，无需 API Key）----
# 定时抓取开关与周期（分钟）
FEED_CRON_ENABLED=true
FEED_CRON_INTERVAL_MINUTES=30
# 单源最多取几条
FEED_LIMIT_PER_SOURCE=30
# HTTP 超时（总/ 连接），秒
FEED_TIMEOUT=15
FEED_CONNECT_TIMEOUT=8
# 过期数据清理：保留天数 / 最小保留条数
FEED_KEEP_DAYS=30
FEED_KEEP_MIN=200

# ---- 热度重算（P1-21，独立于抓取的 cron）----
# 此前热度重算寄生在抓取任务里：抓取被关停时热度永不衰减（热榜排序冻结）。
# 现在独立执行——抓取停不停，时间衰减都按时推进。
HOT_CRON_ENABLED=true
# 重算周期（分钟）。互动发生时即时 bump，周期任务只推进时间衰减，无需跟抓取同频
HOT_CRON_INTERVAL_MINUTES=15
# staleness 窗口（分钟）：只重算锚点早于该窗口的行（窗口 > 周期 → 每行每窗口
# 最多重写一次，避免无变动全表重写；分数最多陈旧一个窗口，半衰期 48h 下排序无感）
HOT_STALE_MINUTES=60

# ---- 示例数据播种 ----
# 是否播种「演示账号 + 示例资讯/评论/消息」。生产默认 false（避免弱口令默认账号与演示内容）；
# 单元测试建议置 false 以保证断言确定性
SEED_SAMPLE_DATA=true

# 种子演示账号（仅当 SEED_SAMPLE_DATA=true 时生效）
DEMO_PHONE=13800138000
DEMO_PASSWORD=123456
# ---- 抓取链路治理（P1-16）----
FEED_MAX_CONCURRENCY=4
FEED_HOST_GAP_SECONDS=1.5
FEED_MIN_INTERVAL_MINUTES=10
FEED_ROBOTS_TTL_HOURS=24
FEED_ALERT_ENABLED=true
FEED_ALERT_STALE_HOURS=24
FEED_ALERT_MIN_INTERVAL_HOURS=6
FEED_ALERT_AGGREGATE_MIN=3
FEED_ALERT_AGGREGATE_LIST=5

# ---- 失败分级与熔断（P1-18）----
# 「可重试」失败（超时 / 5xx / 429 / 连接重置）的重试次数与退避基数（秒，指数退避）
FEED_RETRY_TRANSIENT=2
FEED_RETRY_BACKOFF=0.6
# 连续失败达此次数即熔断：冷却期内整轮跳过该源（0 = 不熔断）
FEED_CIRCUIT_THRESHOLD=5
FEED_CIRCUIT_COOLDOWN_MINUTES=30
# 连续「永久性」失败达此次数后自动禁用该源。
# 默认 0 = **从不自动禁用**——静默关掉一个源、且没人记得重新打开，比一直重试更糟；
# 开启后每次触发都会写审计（source.auto_disable）
FEED_AUTO_DISABLE_PERMANENT=0

# ---- 源健康历史与趋势（P1-19）----
# 健康事件（每轮真实抓取一行）保留天数。过期即无意义，按时间删、不设条数保底——
# 「最近 N 天」就是排障取证的全部价值，保底只会留下一堆最旧的噪音
FEED_HEALTH_KEEP_DAYS=30
# 管理端列表页摘要窗口（短于趋势窗口：列表回答「最近怎么样」，趋势回答「它到底怎么了」）
FEED_HEALTH_LIST_DAYS=7

# ---- 评论内容审核：敏感词（P1-23）----
# 总开关。大面积误杀时的一键止血（改它无需发版，重启即生效；词库仍可维护）
MODERATION_ENABLED=true
# 是否连昵称一起检测（昵称随评论展示，脏昵称等于换个地方贴）
MODERATION_CHECK_NAME=true
# 词库缓存有效期（秒）。到期才回库查一次指纹（MAX(updated_at)+COUNT(*)），
# 指纹没变就继续用内存索引——检测本身不查库；管理端改词会主动失效本进程缓存
MODERATION_CACHE_TTL_SECONDS=30
# 词库最短长度（按归一化后字符数）。1 字词误杀率不可接受（单字在正常表达里遍地都是）
MODERATION_MIN_WORD_LEN=2
# 脱敏替换字符
MODERATION_MASK_CHAR=*
# 兜底动作（库中 action 缺失/未知时）：mask 而非 block——数据异常时降级为
# 「先脱敏留给人看」，而不是把用户发言直接吞掉
MODERATION_DEFAULT_ACTION=mask
# 词库规模上限（条）。防误导入超大词表拖垮内存与构建；超出时截断并告警
MODERATION_MAX_WORDS=20000

# ---- 昵称敏感词校验（P1-24）----
# 总开关。大面积误杀时的一键止血（词库仍可维护，重启即生效）
NICKNAME_MODERATION_ENABLED=true
# 昵称长度边界（按 Unicode 码点计，emoji 记 1）。下限 2：单字名无识别度且易撞车；
# 上限 24：评论列表/通知里放得下，再长会被截断得看不出原样
NICKNAME_MIN_LENGTH=2
NICKNAME_MAX_LENGTH=24
# 词库最短长度（按每个归一化形态的字符数）。对每个形态都把关：折叠形态天然
# 更短（「约约」压缩成「约」），放任它会把任何含「约」的昵称都算成命中
NICKNAME_MIN_WORD_LEN=2
# 词库缓存有效期（秒）。与 MODERATION_CACHE_TTL_SECONDS 同一机制：校验本身
# 不查库，管理端改词主动失效本进程缓存（保存即生效），TTL 只是集群兜底
NICKNAME_CACHE_TTL_SECONDS=30
# 词库规模上限（条，含每条词在各形态展开前的词条数）
NICKNAME_MAX_WORDS=20000
# 是否启用「重复字符压缩」形态（aabbcc → abc）。昵称无语义、长度有限，误杀面
# 远比评论正文小，故默认开；出现误杀可关（其余形态不受影响）
NICKNAME_COLLAPSE_REPEATS=true
# 昵称允许的符号白名单（字母/数字/汉字另按 Unicode L*/N* 放行）。
# 空格不走这里——_env 会 strip 整个值，尾随空格在环境变量里活不下来；
# 空格由代码额外允许（首尾一律 trim，只放行内部空格）
NICKNAME_ALLOWED_SYMBOLS=_-·.・
